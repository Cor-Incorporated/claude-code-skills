{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash",
      "WebSearch",
      "WebFetch",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__brave-search__brave_web_search",
      "mcp__brave-search__brave_local_search",
      "mcp__codex__codex",
      "Bash(openssl rand:*)",
      "Bash(source:*)",
      "Bash(curl:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(pip3 install:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(supabase:*)",
      "Bash(vercel:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(lsof:*)",
      "Bash(test:*)",
      "Bash(set:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(sudo dscacheutil:*)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:developers.linear.app)",
      "WebFetch(domain:studio.apollographql.com)",
      "WebFetch(domain:docs.x.ai)"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-init-permissions.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-reset.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/reset-factcheck.sh"
          },
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=SessionStart bash ~/.claude/hooks/enforce-git-freshness.sh",
            "timeout": 15,
            "statusMessage": "Checking git freshness..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/validate-no-local-hooks.sh",
            "timeout": 5,
            "statusMessage": "Validating settings.local.json has no hook overrides..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-read-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-state-file-tampering.sh",
            "timeout": 5,
            "statusMessage": "Checking state file integrity..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-edit-write-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-write-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-factcheck-before-edit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-linter-config.sh",
            "timeout": 5,
            "statusMessage": "Checking linter config protection..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-agent-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-state-file-tampering.sh",
            "timeout": 5,
            "statusMessage": "Checking state file integrity..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-edit-write-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-factcheck-before-edit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-version-downgrade.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-linter-config.sh",
            "timeout": 5,
            "statusMessage": "Checking linter config protection..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-state-file-tampering-bash.sh",
            "timeout": 5,
            "statusMessage": "Checking state file integrity..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-branches.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git-push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/codex-task-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/codex-task-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-manual-merge-ops.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git-commit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_MODE=PRE_MERGE bash ~/.claude/hooks/pr-ci-review-gate.sh",
            "timeout": 30,
            "statusMessage": "Enforcing CI green + review gate before merge..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-review-reading.sh",
            "timeout": 10,
            "statusMessage": "Checking unresolved review findings..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-merge-without-ci.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-merge-without-review.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pr-merge-claude-review-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/audit-docker-build-args.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-architecture-layers.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-issue-close-verification.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-seed-data-verification.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-factcheck-before-user-request.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PreToolUse bash ~/.claude/hooks/enforce-git-freshness.sh",
            "timeout": 15,
            "statusMessage": "Checking git freshness..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_MODE=PRE_CREATE bash ~/.claude/hooks/pr-ci-review-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking review pipeline (code-reviewer + Codex)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pr-guard.sh",
            "timeout": 30,
            "statusMessage": "Checking PR guard (base branch, issue ref, conflicts)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/inject-claude-review-on-checks.sh",
            "timeout": 30,
            "statusMessage": "Fetching claude-review comments..."
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys, re; from datetime import datetime; input_data = json.load(sys.stdin); tool_input = input_data.get('tool_input', {}); query = tool_input.get('query', ''); current_year = str(datetime.now().year); has_year = re.search(r'\\\\b20\\\\d{2}\\\\b', query); has_temporal = any(word in query.lower() for word in ['latest', 'recent', 'current', 'new', 'now', 'today']); should_add_year = not has_year and not has_temporal; modified_query = f'{query} {current_year}' if should_add_year else query; output = {'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'modifiedToolInput': {'query': modified_query}}}; print(json.dumps(output)); sys.exit(0)\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-local-hooks-write.sh",
            "timeout": 5,
            "statusMessage": "Checking settings.local.json for hooks override..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/mark-factcheck-done.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/mark-factcheck-done.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-agent-team.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/record-code-review.sh",
            "timeout": 10,
            "statusMessage": "Recording code review completion..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-memory-update-on-commit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/codex-task-release.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-merge-close-issues.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-deploy-verify.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-test-falsifiability.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-domain-naming.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-endpoint-dataflow.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-doc-update-scope.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_MODE=POST_PUSH bash ~/.claude/hooks/pr-ci-review-gate.sh",
            "timeout": 15,
            "statusMessage": "Setting review lock..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/workflow-sync-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking workflow file sync..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-lint-format.sh",
            "timeout": 5,
            "statusMessage": "Running PostToolUse Quality Loop (lint + format)..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|Grep|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tool-failure-recovery.sh",
            "timeout": 5,
            "statusMessage": "Analyzing tool failure..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_MODE=STOP bash ~/.claude/hooks/pr-ci-review-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking unverified PRs..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-test-gate.sh",
            "timeout": 75,
            "statusMessage": "Running project tests before stop..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/task-completion-gate.sh",
            "timeout": 30,
            "statusMessage": "Verifying CI and review status..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-harness@claude-code-harness-marketplace": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "ツンデレ後輩女子",
  "effortLevel": "high",
  "fastMode": true,
  "voiceEnabled": false
}
