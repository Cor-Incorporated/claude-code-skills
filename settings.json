{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(./build.sh)",
      "Bash(./node_modules/.bin/astro:*)",
      "Bash(astro:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(find:*)",
      "Bash(firebase:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(markdownlint:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx astro:*)",
      "Bash(npx markdownlint:*)",
      "Bash(npx playwright:*)",
      "Bash(nslookup:*)",
      "Bash(open http://localhost:4321/blog)",
      "Bash(open http://localhost:4321/blog/react-hooks-guide/)",
      "Bash(openssl rand:*)",
      "Bash(pip3 install:*)",
      "Bash(pkill:*)",
      "Bash(pnpm:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(set:*)",
      "Bash(sips:*)",
      "Bash(source:*)",
      "Bash(sudo dscacheutil:*)",
      "Bash(supabase:*)",
      "Bash(test:*)",
      "Bash(timeout 30 npm run build)",
      "Bash(timeout 5 curl -w \"%{http_code}\" -s -o /dev/null http://localhost:4321/blog)",
      "Bash(vercel:*)",
      "Bash(wc:*)",
      "Bash(wget:*)",
      "Bash(xargs:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebFetch(domain:cor-jp.com)",
      "WebFetch(domain:developers.linear.app)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.x.ai)",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:studio.apollographql.com)",
      "WebSearch",
      "Write",
      "mcp__brave-search__brave_local_search",
      "mcp__brave-search__brave_web_search",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__find_file",
      "mcp__serena__find_symbol",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__list_dir",
      "mcp__serena__onboarding",
      "mcp__serena__search_for_pattern",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__write_memory"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-init-permissions.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/validate-no-local-hooks.sh",
            "timeout": 5,
            "statusMessage": "Validating settings.local.json has no hook overrides..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/validate-provider-env.sh",
            "timeout": 8,
            "statusMessage": "Checking API provider routing (anthropic/z.ai)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-branch-workflow.sh",
            "timeout": 15,
            "statusMessage": "Checking branch workflow..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-hook-deploy-integrity.sh",
            "timeout": 15,
            "statusMessage": "Checking hook deployment integrity + auto-sync..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-update-plugins.sh",
            "timeout": 60,
            "statusMessage": "Updating third-party plugins (24h cooldown)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/dns-self-heal.sh",
            "timeout": 15,
            "statusMessage": "Checking DNS reachability (negative-cache self-heal)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-branches.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git-push-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-local-hooks-write.sh",
            "timeout": 5,
            "statusMessage": "Checking settings.local.json for hooks override..."
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys, re; from datetime import datetime; input_data = json.load(sys.stdin); tool_input = input_data.get('tool_input', {}); query = tool_input.get('query', ''); current_year = str(datetime.now().year); has_year = re.search(r'\\\\b20\\\\d{2}\\\\b', query); has_temporal = any(word in query.lower() for word in ['latest', 'recent', 'current', 'new', 'now', 'today']); should_add_year = not has_year and not has_temporal; modified_query = f'{query} {current_year}' if should_add_year else query; output = {'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'modifiedToolInput': {'query': modified_query}}}; print(json.dumps(output)); sys.exit(0)\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-agent-output.sh",
            "timeout": 5,
            "statusMessage": "Verifying agent output..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-commit-worktree-changes.sh",
            "timeout": 15,
            "statusMessage": "Auto-committing worktree agent changes..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-deploy-verify.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-hook-deploy-after-merge.sh",
            "timeout": 30,
            "statusMessage": "Auto-deploying hooks after PR merge..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/aidd-async-register.sh",
            "timeout": 10,
            "statusMessage": "Registering async work carry-over..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-lint-format.sh",
            "timeout": 5,
            "statusMessage": "Running PostToolUse Quality Loop (lint + format)..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-agent-failure.sh",
            "timeout": 5,
            "statusMessage": "Propagating agent failure context..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Grep|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tool-failure-recovery.sh",
            "timeout": 5,
            "statusMessage": "Analyzing tool failure..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-compact-context-save.sh",
            "timeout": 10,
            "statusMessage": "Saving context before compaction..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/aidd-h3-evidence-stop.sh",
            "timeout": 8,
            "statusMessage": "H3 evidence trailer check (warn only)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/aidd-turn-boundary-stop.sh",
            "timeout": 10,
            "statusMessage": "Checking unresolved async work before ending the turn..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-harness@claude-code-harness-marketplace": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "ツンデレ後輩女子",
  "effortLevel": "high",
  "fastMode": true,
  "voiceEnabled": false
}
