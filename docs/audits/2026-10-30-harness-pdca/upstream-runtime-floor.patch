+package runtimefloor
+
+import "testing"
+
+// Commands taken from real denials on 2026-10-30 (cluster operations from a
+// Mac: LAN 192.168.11.0/24, tailnet 100.64.0.0/10, nodes by short name).
+func TestEgress_OperandParsing(t *testing.T) {
+	root := testWorktreeRoot(t)
+	clusterAllow := "192.168.11.0/24,100.64.0.0/10,evo-x2,jetson-thor,.tail1234.ts.net"
+
+	cases := []struct {
+		name  string
+		allow string
+		cmd   string
+		stop  bool
+	}{
+		// false positives in 5.16.0
+		{"local rsync with a .md operand", "", "rsync -a --delete ./snap-before/ ./snap-after/ && cp CLAUDE.md x/", false},
+		{"nc with options to localhost", "", "nc -z -G 3 127.0.0.1 22", false},
+		{"nc options to an allowlisted LAN host", clusterAllow, "nc -z -G 3 -w 3 192.168.11.23 445", false},
+		{"curl to an allowlisted LAN host with port", clusterAllow, "curl -s http://192.168.11.28:4000/health", false},
+		{"curl to an allowlisted node name", clusterAllow, "curl -s http://evo-x2:8080/v1/models", false},
+		{"curl to an allowlisted tailnet suffix", clusterAllow, "curl -s http://evo-x2.tail1234.ts.net:8080/v1/models", false},
+		{"scp to an allowlisted node, module name later", clusterAllow,
+			"scp scripts/e2e/run.sh jetson-thor:ets/ && ssh jetson-thor 'python -m engineai_thor_sidecar.cli run'", false},
+		{"rsync to an allowlisted tailnet IP", clusterAllow, "rsync -av ./models/ 100.76.44.16:/srv/models/", false},
+
+		// still denied
+		{"nc with options to a LAN host, no allowlist", "", "nc -z -G 3 -w 3 192.168.11.23 445", true},
+		{"external curl with the cluster allowlist", clusterAllow, "curl -s https://pypi.org/pypi/awscrt/json", true},
+		{"scp to an external name with the cluster allowlist", clusterAllow, "scp ./build deploy@files.example.com:/srv/", true},
+		{"nested rsync keeps the conservative scan", clusterAllow, `sh -c "rsync -a f deploy@files.example.com:/x"`, true},
+		{"allowlist suffix does not match a look-alike", clusterAllow, "curl -s https://evil-tail1234.ts.net.example.com/", true},
+
+		// false negatives in 5.16.0 (raw IP destinations were never matched)
+		{"scp to an external IP", "", "scp ./build deploy@203.0.113.7:/srv/", true},
+		{"rsync to an external IP", "", "rsync -a ./out/ 198.51.100.4:/srv/out/", true},
+		{"scp to a bracketed IPv6", "", "scp f [2001:db8::7]:/srv/", true},
+
+		// all-open declarations are discarded
+		{"wildcard allow is ignored", "*", "curl https://example.com/", true},
+		{"0.0.0.0/0 is ignored", "0.0.0.0/0", "nc -z 203.0.113.9 22", true},
+		{"::/0 is ignored", "::/0", "curl http://[2001:db8::1]/", true},
+		{"a /4 is ignored", "0.0.0.0/4", "nc -z 10.1.1.1 22", true},
+		{"glob entries are ignored", "*.example.com", "curl https://api.example.com/", true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("HARNESS_RUNTIME_FLOOR_EGRESS_ALLOW", tc.allow)
+			d := CheckCommand(tc.cmd, Context{WorktreeRoot: root})
+			if d.Stopped != tc.stop {
+				t.Fatalf("CheckCommand(%q) with allow=%q: stopped=%v (%s), want %v",
+					tc.cmd, tc.allow, d.Stopped, d.Reason, tc.stop)
+			}
+			if d.Stopped && d.Category != CategoryEgress {
+				t.Fatalf("CheckCommand(%q): category=%s, want egress", tc.cmd, d.Category)
+			}
+		})
+	}
+}
