+package runtimefloor
+
+import (
+	"net"
+	"os"
+	"strings"
+)
+
+// HARNESS_RUNTIME_FLOOR_EGRESS_ALLOW names destinations the operator treats as
+// internal (comma separated): an IP, a CIDR, an exact host name, or a
+// ".suffix" that matches the suffix and its subdomains. Entries that would
+// open every destination ("*", "0.0.0.0/0", "::/0", a CIDR wider than /8 for
+// IPv4 or /16 for IPv6, "." or an empty string) are discarded, like the
+// secret-read allowlist discards all-open declarations. The variable cannot
+// disable the category; HARNESS_RUNTIME_FLOOR_EGRESS=off remains the only
+// switch for that.
+type egressAllow struct {
+	nets     []*net.IPNet
+	ips      []net.IP
+	hosts    map[string]bool
+	suffixes []string
+}
+
+func loadEgressAllow() egressAllow {
+	a := egressAllow{hosts: map[string]bool{}}
+	for _, raw := range strings.Split(os.Getenv("HARNESS_RUNTIME_FLOOR_EGRESS_ALLOW"), ",") {
+		e := strings.ToLower(strings.TrimSpace(strings.Trim(strings.TrimSpace(raw), `"'`)))
+		switch {
+		case e == "" || e == "*" || e == "." || strings.ContainsAny(e, "*?[]"):
+			continue
+		case strings.Contains(e, "/"):
+			_, n, err := net.ParseCIDR(e)
+			if err != nil {
+				continue
+			}
+			ones, bits := n.Mask.Size()
+			if (bits == 32 && ones < 8) || (bits == 128 && ones < 16) {
+				continue
+			}
+			a.nets = append(a.nets, n)
+		case net.ParseIP(e) != nil:
+			a.ips = append(a.ips, net.ParseIP(e))
+		case strings.HasPrefix(e, "."):
+			if strings.Count(e, ".") < 1 || len(e) < 3 {
+				continue
+			}
+			a.suffixes = append(a.suffixes, e)
+		default:
+			a.hosts[e] = true
+		}
+	}
+	return a
+}
+
+func (a egressAllow) allows(host string) bool {
+	host = strings.ToLower(strings.TrimSuffix(host, "."))
+	if host == "" {
+		return false
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		for _, n := range a.nets {
+			if n.Contains(ip) {
+				return true
+			}
+		}
+		for _, x := range a.ips {
+			if x.Equal(ip) {
+				return true
+			}
+		}
+		return false
+	}
+	if a.hosts[host] {
+		return true
+	}
+	for _, s := range a.suffixes {
+		if strings.HasSuffix(host, s) || host == strings.TrimPrefix(s, ".") {
+			return true
+		}
+	}
+	return false
+}
+
+// bareHost strips userinfo, brackets and a port from a destination token:
+// user@host:22 → host, [fd00::1]:22 → fd00::1, 192.168.11.28:4000 → 192.168.11.28.
+func bareHost(token string) string {
+	h := strings.Trim(token, `"'`)
+	if at := strings.LastIndex(h, "@"); at >= 0 {
+		h = h[at+1:]
+	}
+	if strings.HasPrefix(h, "[") {
+		if end := strings.Index(h, "]"); end > 0 {
+			return h[1:end]
+		}
+	}
+	if strings.Count(h, ":") == 1 {
+		h = h[:strings.Index(h, ":")]
+	}
+	return strings.TrimSuffix(h, ":")
+}
+
+// ncOptionsWithArgument are the netcat options (BSD and OpenBSD nc) whose next
+// token is the option's value, not the destination.
+var ncOptionsWithArgument = map[string]bool{
+	"-G": true, "-I": true, "-i": true, "-M": true, "-m": true, "-O": true,
+	"-P": true, "-p": true, "-q": true, "-s": true, "-T": true, "-V": true,
+	"-W": true, "-w": true, "-X": true, "-x": true,
+}
+
+// ncDestination returns the first operand after nc that is not an option or
+// an option's value. "nc -z -G 3 -w 3 10.0.0.5 445" → "10.0.0.5". The old
+// check read the token right after nc ("-z") as the host, so every nc with an
+// option was denied, including nc to localhost.
+func ncDestination(fields []string, i int) string {
+	for j := i + 1; j < len(fields); j++ {
+		f := fields[j]
+		if isSegmentBreak(f) {
+			return ""
+		}
+		if strings.HasPrefix(f, "-") && len(f) > 1 {
+			if ncOptionsWithArgument[f] {
+				j++
+			}
+			continue
+		}
+		return strings.TrimRight(f, ";&|")
+	}
+	return ""
+}
+
+func isSegmentBreak(f string) bool {
+	switch f {
+	case ";", "&&", "||", "|", "&", "\n":
+		return true
+	}
+	return false
+}
+
+// remoteOperand reports the host of an scp/rsync operand that names a remote
+// side: [user@]host:path, rsync://host/..., scp://host/... A local path
+// ("./dist/", "CLAUDE.md", "/abs/path") is not remote. Unlike the
+// remoteHostPattern scan, an IP destination is recognized, so
+// "scp f deploy@203.0.113.7:/srv/" is no longer allowed by accident.
+func remoteOperand(token string) (string, bool) {
+	t := strings.TrimRight(strings.Trim(token, `"'`), ";&|")
+	lower := strings.ToLower(t)
+	for _, scheme := range []string{"rsync://", "scp://", "sftp://", "ssh://"} {
+		if strings.HasPrefix(lower, scheme) {
+			rest := t[len(scheme):]
+			if slash := strings.Index(rest, "/"); slash >= 0 {
+				rest = rest[:slash]
+			}
+			return bareHost(rest), true
+		}
+	}
+	if strings.HasPrefix(t, "/") || strings.HasPrefix(t, ".") || strings.HasPrefix(t, "~") || strings.HasPrefix(t, "-") {
+		return "", false
+	}
+	if strings.HasPrefix(t, "[") {
+		if end := strings.Index(t, "]:"); end > 0 {
+			return t[1:end], true
+		}
+		return "", false
+	}
+	colon := strings.Index(t, ":")
+	if colon <= 0 {
+		return "", false
+	}
+	if slash := strings.Index(t, "/"); slash >= 0 && slash < colon {
+		return "", false
+	}
+	return bareHost(t[:colon+1]), true
+}
+
+// copyDestinations returns, for every scp/rsync field, the remote hosts named
+// by its operands up to the end of the segment. found is false when the text
+// mentions scp/rsync but no field is exactly the command name (quoted, nested
+// in sh -c, behind a path): the caller then keeps the conservative scan.
+func copyDestinations(fields []string) (hosts []string, found bool) {
+	for i, f := range fields {
+		name := strings.ToLower(f)
+		if name != "scp" && name != "rsync" {
+			continue
+		}
+		found = true
+		for j := i + 1; j < len(fields); j++ {
+			if isSegmentBreak(fields[j]) {
+				break
+			}
+			if h, ok := remoteOperand(fields[j]); ok {
+				hosts = append(hosts, h)
+			}
+			if strings.HasSuffix(fields[j], ";") {
+				break
+			}
+		}
+	}
+	return hosts, found
+}
